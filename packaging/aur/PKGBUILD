# Maintainer: Lampu <lampu@cord.lamp.delivery>
pkgname=lampcord-bin
pkgver=1.0.0
pkgrel=1
pkgdesc='Lightweight Discord client built with Kotlin Multiplatform'
arch=('x86_64')
url='https://cord.lamp.delivery'
license=('GPL-3.0-or-later')
depends=('glibc' 'fuse2' 'java-runtime' 'libx11' 'libxext' 'libxrender' 'libxtst' 'libxi' 'libxkbcommon')
optdepends=(
  'webkit2gtk-4.1: embedded web content'
  'pipewire: voice calls'
  'libnotify: desktop notifications'
)
provides=('lampcord')
conflicts=('lampcord')
options=('!strip' '!debug')
source=(
  "lampcord-desktop-linux-x64-${pkgver}.AppImage::https://github.com/l6t9/Lampcord/releases/download/v${pkgver}/lampcord-desktop-linux-x64-${pkgver}.AppImage"
  'lampcord.desktop'
  'lampcord.png'
)
sha256sums=('c6429e25d6995aa68721335b2520a82098ac51f8aa960659a3b1dc8143be07ad'
            'aad7c190d678bfe5c5b9c91d7b6075f0b63ecdfebe08d3bfe542f867db04da31'
            'b05f31ca9c0e6e1f091b6e848773703334a78ba19834b6dc6f1cebefbea6eb75')

package() {
  install -Dm755 "${srcdir}/lampcord-desktop-linux-x64-${pkgver}.AppImage" \
    "${pkgdir}/usr/bin/lampcord"

  install -Dm644 "${srcdir}/lampcord.desktop" \
    "${pkgdir}/usr/share/applications/lampcord.desktop"

  install -Dm644 "${srcdir}/lampcord.png" \
    "${pkgdir}/usr/share/icons/hicolor/1024x1024/apps/lampcord.png"
}
