# Maintainer: Lampu <lampu@cord.lamp.delivery>
pkgname=lampcord-bin
pkgver=1.0.5
pkgrel=1
pkgdesc='Lightweight Discord client built with Kotlin Multiplatform'
arch=('x86_64')
url='https://cord.lamp.delivery'
license=('GPL-3.0-or-later')
# No fuse2: the jar is unpacked by the Nucleus runtime into ~/.cache/nucleus, so there is
# no self-mounting AppImage involved. The jlink runtime under /usr/lib/lampcord/runtime comes
# with the source tarball, so there is no jre-openjdk dependency either.
depends=('glibc' 'libx11' 'libxext' 'libxrender' 'libxtst' 'libxi' 'libxkbcommon' 'gtk3' 'libnotify' 'nss' 'libxss' 'at-spi2-core' 'util-linux-libs' 'libsecret' 'xdg-utils')
optdepends=(
  'webkit2gtk-4.1: embedded web content'
  'pipewire: voice calls'
  'libappindicator-gtk3: tray icon'
)
provides=('lampcord')
conflicts=('lampcord')
options=('!strip' '!debug')
source=("lampcord-desktop-linux-x64-${pkgver}.tar.gz::https://github.com/l6t9/Lampcord/releases/download/v${pkgver}/lampcord-desktop-linux-x64-${pkgver}.tar.gz")
# One self-contained tarball carries the jar, launcher, desktop file and both icons, so the
# sources stay pinned to a single release artifact instead of five separate URLs. The checksum
# below matches the tarball published with this release; regenerate it with `updpkgsums` when a
# new release uploads its own tarball. CI rewrites this for the AUR tarball it packages in
# .github/workflows/reusable-desktop-linux.yml.
sha256sums=('8588c732d246cab37ed53a3b64e71c40969a98c372f207da8f1f495698febab1')

package() {
  install -Dm644 "${srcdir}/lampcord/lampcord.jar" \
    "${pkgdir}/usr/lib/lampcord/lampcord.jar"

  install -Dm755 "${srcdir}/lampcord/lampcord-launcher" "${pkgdir}/usr/bin/lampcord"

  cp -a "${srcdir}/lampcord/runtime" "${pkgdir}/usr/lib/lampcord/runtime"

  install -Dm644 "${srcdir}/lampcord/lampcord.desktop" \
    "${pkgdir}/usr/share/applications/lampcord.desktop"

  install -Dm644 "${srcdir}/lampcord/lampcord.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/lampcord.png"

  install -Dm644 "${srcdir}/lampcord/lampcord.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/lampcord.svg"
}