//
// Config.xcconfig
// Lampcord iOS App Scaffold Configuration
//

PRODUCT_NAME = Lampcord
PRODUCT_BUNDLE_IDENTIFIER = me.lampu.lampcord
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 5.9
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SDKROOT = iphoneos
// The KMP dependency graph publishes arm64 simulator binaries only.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
TARGETED_DEVICE_FAMILY = 1,2
// The Kotlin framework is produced by a Gradle task that writes into the build directory,
// which the user script sandbox would block.
ENABLE_USER_SCRIPT_SANDBOXING = NO
